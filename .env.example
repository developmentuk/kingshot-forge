VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Kingshot Auto Redeem configuration. Leave unset/disabled locally
# until an approved signing key and controlled test player are available.
# Player ID and kingdom ID are resolved from the ownership-verified Governor.
GIFTCODE_REDEMPTION_ENABLED=false
GIFTCODE_OFFICIAL_PROVIDER_ENABLED=false
GIFTCODE_PROVIDER_ENVIRONMENT_APPROVED=false
GIFTCODE_QUEUE_PROCESSING_ENABLED=false
KINGSHOT_REDEMPTION_CODE_URL=https://kingshot-giftcode.centurygame.com/api/gift_code
KINGSHOT_REDEMPTION_SIGNING_KEY=server-only-placeholder
KINGSHOT_REDEMPTION_TIMEOUT_MS=15000
