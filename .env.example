VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only official Kingshot Player Lookup configuration.
# The signature salt is supplied by the approved Century Games integration.
# The provider secret is a Forge-generated random value of at least 32 characters
# used only to seal short-lived CAPTCHA challenges and lookup receipts.
KINGSHOT_PLAYER_API_HOST=https://ks-giftcode.centurygame.com
KINGSHOT_PLAYER_SIGNATURE_SALT=server-only-placeholder
KINGSHOT_PLAYER_PROVIDER_SECRET=generate-a-random-server-only-secret-of-at-least-32-characters

# Server-only Kingshot Auto Redeem configuration. Leave unset/disabled locally
# until an approved signing key and controlled test player are available.
# Player ID and kingdom ID are resolved from the verified linked Governor.
KINGSHOT_REDEMPTION_CODE_URL=https://kingshot-giftcode.centurygame.com/api/gift_code
KINGSHOT_REDEMPTION_SIGNING_KEY=server-only-placeholder
KINGSHOT_REDEMPTION_ENABLED=false
KINGSHOT_REDEMPTION_TIMEOUT_MS=15000
