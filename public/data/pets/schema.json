{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksforge.app/data/pets/schema.json",
  "title": "Kingshot Forge PETS-001A split dataset contract",
  "description": "Schema definitions for the PETS-001A metadata, compact pet identity and shared progression curve documents.",
  "oneOf": [
    { "$ref": "#/$defs/metadataDocument" },
    { "$ref": "#/$defs/petsDocument" },
    { "$ref": "#/$defs/progressionCurveDocument" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "levelRow": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 2, "maximum": 100 },
        { "type": "integer", "minimum": 0 },
        { "type": ["integer", "null"], "minimum": 0 },
        { "type": ["integer", "null"], "minimum": 0 },
        { "type": ["integer", "null"], "minimum": 0 }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "skillRow": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 10 },
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": ["string", "null"], "minLength": 1 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "sequentialSkillRows": {
      "type": "array",
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 1 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 2 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 3 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 4 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 5 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 6 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 7 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 8 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 9 }] }] },
        { "allOf": [{ "$ref": "#/$defs/skillRow" }, { "prefixItems": [{ "const": 10 }] }] }
      ],
      "minItems": 1,
      "maxItems": 10
    },
    "sequentialLevelRows": {
      "type": "array",
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 2 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 3 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 4 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 5 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 6 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 7 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 8 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 9 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 10 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 11 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 12 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 13 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 14 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 15 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 16 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 17 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 18 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 19 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 20 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 21 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 22 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 23 }] }] },
        { "allOf": [{ "$ref": "#/$defs/levelRow" }, { "prefixItems": [{ "const": 24 }] }] },
