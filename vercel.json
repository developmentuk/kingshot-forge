{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/player/link-ocr.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,@tesseract.js-data/eng}/**"
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "castle-command-preview": true
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
