{
  "name": "kingshot-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fix:nodenext": "node scripts/fix-nodenext-imports.mjs --write",
    "validate:nodenext": "node scripts/fix-nodenext-imports.mjs",
    "validate:pm2b": "node scripts/validate-pm2b.mjs",
